# ==============================================================================
# Trend-Dashboard Production Docker 환경변수 템플릿 (.env.docker)
# ==============================================================================

# PostgreSQL 설정
POSTGRES_DB=trend_db
POSTGRES_USER=trend_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_PORT=5432

# Redis & Elasticsearch 포트
REDIS_PORT=6379
ES_PORT=9200

# 프론트엔드 서빙 포트
FRONTEND_PORT=80

# KIS 한국투자증권 OpenAPI 키 및 도메인
# 실전투자: https://openapi.koreainvestment.com:9443
# 모의투자: https://openapivts.koreainvestment.com:29443
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_DOMAIN=https://openapivts.koreainvestment.com:29443

# 공공데이터포털(data.go.kr) 서비스키 (인코딩/디코딩 키)
DATA_GO_KR_SERVICE_KEY=your_public_data_service_key

# Google Gemini API 키
GEMINI_API_KEY=your_gemini_api_key
