# ==============================================================================
# Trend-Dashboard 프론트엔드 환경변수 템플릿 (.env.example)
#
# [사용 방법]
# 본 파일을 복사하여 같은 디렉토리(frontend/)에 '.env'로 저장하세요.
# ==============================================================================

# 1. 백엔드 API 및 WebSocket 프록시 경로 (로컬 개발 환경에서는 빈 값 유지 시 Vite 프록시 자동 연동)
VITE_API_BASE_URL=
VITE_WS_URL=/ws

# 2. 카카오맵 JavaScript 앱 키 (프롭테크 국토부 실거래가 지도 연동용)
# 발급 방법:
# 1) https://developers.kakao.com 로그인
# 2) [내 애플리케이션] -> [애플리케이션 추가하기]
# 3) [앱 키] 중 'JavaScript 키'를 복사하여 아래에 입력
# 4) [플랫폼] -> [Web] 등록 -> 사이트 도메인에 'http://localhost:15173' 등록 필수!
VITE_KAKAO_MAP_APP_KEY=your_kakao_javascript_key_here
