# ==============================================================================
# Trend-Dashboard 백엔드 비공개 키 설정 템플릿 (application-secret.yml.example)
#
# [사용 방법]
# 본 파일을 복사하여 같은 디렉토리에 'application-secret.yml'로 저장하고,
# 보유하고 계신 API 키를 입력하세요. (application-secret.yml은 .gitignore에 포함되어 안전합니다)
# ==============================================================================

# 1. 한국투자증권(KIS) OpenAPI (국내 주식 실시간 시세/차트)
# 발급처: https://apiportal.koreainvestment.com
kis:
  open-api:
    app-key: "YOUR_KIS_APP_KEY"
    app-secret: "YOUR_KIS_APP_SECRET"
    # 실전투자: https://openapi.koreainvestment.com:9443
    # 모의투자: https://openapivts.koreainvestment.com:29443
    domain: "https://openapivts.koreainvestment.com:29443"

# 2. 공공데이터포털 (국토부 아파트/오피스텔 실거래가 및 기상청 날씨)
# 발급처: https://www.data.go.kr (Decoding 또는 Encoding 일반 인증키)
public-data:
  service-key: "YOUR_DATA_GO_KR_SERVICE_KEY"

# 3. Google Gemini 1.5 Flash (AI 금융 뉴스 요약 및 시장 영향도 감성 분석)
# 발급처: https://aistudio.google.com/app/apikey (무료 발급 가능)
gemini:
  api-key: "YOUR_GEMINI_API_KEY"

# 4. 코레일 모바일 세션 (원클릭 자동 로그인 및 SMS 알림용)
# 코레일 멤버십 번호(10자리) 및 비밀번호
korail:
  member-no: "YOUR_KORAIL_MEMBER_NO"
  password: "YOUR_KORAIL_PASSWORD"
  phone-no: "01012345678"

# 5. 스마트폰 텔레그램 알림 봇 (취소표/예매대기 선점 시 스마트폰 긴급 푸시)
# 발급처: 텔레그램 @BotFather (/newbot 으로 봇 생성 후 토큰 수신)
# 내 Chat ID 확인: 텔레그램 @userinfobot 검색 후 대화 시작
telegram:
  bot-token: "YOUR_TELEGRAM_BOT_TOKEN"
  chat-id: "YOUR_TELEGRAM_CHAT_ID"
  enabled: true
